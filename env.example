# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... : Optionnel. Clés/projets Gemini
# SUPPLÉMENTAIRES et légitimement obtenus (ex: un second projet Google Cloud
# avec son propre quota). L'orchestrateur IA (server/aiOrchestrator.ts) les
# utilise comme pool indépendant : quand la clé n°1 atteint son quota, la
# clé n°2 prend le relais automatiquement, sans jamais dépasser les
# conditions d'utilisation de Google (ce n'est PAS un moyen de contourner
# un quota, juste d'utiliser plusieurs quotas légitimes en parallèle).
# GEMINI_API_KEY_2="MY_SECOND_GEMINI_API_KEY"

# OPENAI_API_KEY: Optionnel. Second moteur IA (ChatGPT). Si défini, le site
# bascule automatiquement sur OpenAI quand Gemini est indisponible (quota
# dépassé, panne, clé absente). Même méthodologie de rédaction appliquée
# quel que soit le moteur utilisé. Créez une clé sur platform.openai.com.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_API_KEY_2, OPENAI_API_KEY_3, ... : mêmes principes que pour Gemini
# ci-dessus, mais pour OpenAI.
# OPENAI_API_KEY_2="MY_SECOND_OPENAI_API_KEY"

# GOOGLE_TRANSLATE_API_KEY: Optionnel, et non requis pour avoir une traduction
# de secours (voir ci-dessous). /api/translate-text tente d'abord un point
# d'accès Google Traduction gratuit et non-officiel qui ne demande aucune clé.
# Cette clé sert uniquement de filet de sécurité supplémentaire SI ce point
# d'accès gratuit venait à être bloqué/rate-limité par Google sous forte charge.
# Pour l'obtenir : console.cloud.google.com -> activer "Cloud Translation API"
# sur un projet -> Identifiants -> Créer une clé API (restreindre cette clé à
# la seule API Cloud Translation). Le niveau gratuit couvre 500 000 caractères/mois.
GOOGLE_TRANSLATE_API_KEY="MY_GOOGLE_TRANSLATE_API_KEY"

# REDIS_URL: Optionnel. Si le site est déployé sur PLUSIEURS instances
# (scaling horizontal), configurez une URL Redis (ex: "redis://user:pass@host:6379")
# pour que le rate limiter (server/rateLimiter.ts) partage ses compteurs
# entre toutes les instances au lieu de compter séparément par instance.
# Nécessite le paquet optionnel `ioredis` (npm install ioredis). Sans
# REDIS_URL, ou si ioredis n'est pas installé, le site fonctionne quand même
# normalement avec un compteur en mémoire par instance.
# REDIS_URL="redis://localhost:6379"

# GLOBAL_AI_MAX_REQUESTS_PER_MIN: Optionnel (défaut 600). Plafond GLOBAL, tous
# utilisateurs confondus, de requêtes IA par minute — un garde-fou pour ne
# jamais totalement saturer les clés API configurées lors d'un pic massif
# (ex: une classe entière qui se connecte au même moment). À augmenter si vous
# avez configuré plusieurs clés/projets avec un quota cumulé plus élevé.
# GLOBAL_AI_MAX_REQUESTS_PER_MIN=600

# SHOW_FALLBACK_NOTICE: Optionnel (défaut false). Si true, le chat-tuteur
# ajoute une phrase discrète ("Réponse générée avec une autre capacité
# disponible.") quand l'orchestrateur (server/aiOrchestrator.ts) a dû
# basculer sur un modèle/clé secondaire pour répondre. Ne révèle jamais de
# détail technique (clé, fournisseur exact, stack trace). Laissé à false par
# défaut car une bascule totalement invisible est en général préférable pour
# l'élève.
# SHOW_FALLBACK_NOTICE=false

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

